---
import Base from '../layouts/Base.astro';
import FormGuard from '../components/FormGuard.astro';
---
<Base title="Contact | Adam Tank" description="Get in touch with Adam Tank for speaking, consulting, or anything else.">
  <div class="wrap">
    <section class="section" data-hide-on-success>
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p>
        Speaking inquiry, consulting question, or just want to say hello? Use the form below.
        I read every submission.
      </p>
    </section>
    <section class="section">
      <form method="POST" action="/api/contact" data-async>
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <input id="subject" name="subject" required />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="7" required></textarea>
        </div>
        <FormGuard />
        <button class="btn" type="submit">Send message</button>
      </form>
      <p class="form-note" hidden data-success>Thanks for reaching out. I'll get back to you within 48 to 72 hours.</p>
      <p class="form-error" hidden data-error></p>
    </section>
  </div>
  <style>
    .form-note { color: var(--accent); font-weight: 600; }
    .form-error { color: #b3261e; font-weight: 600; }
  </style>
  <script>
    import '../scripts/async-forms.ts';
  </script>
</Base>
