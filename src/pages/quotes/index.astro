---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { entryUrl } from '../../lib/urls';

const quotes = (await getCollection('quotes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Quotes | Adam Tank" description="A running collection of quotes worth keeping.">
  <div class="wrap-wide">
    <section class="section">
      <p class="eyebrow">Collected over the years</p>
      <h1>Quotes</h1>
      <p>Words worth keeping, one at a time.</p>
    </section>
    <div class="card-grid">
      {quotes.map((q) => (
        <article class="card">
          {q.data.image && (
            <a href={entryUrl(q, 'quotes')}><img src={q.data.image} alt="" loading="lazy" /></a>
          )}
          <div class="card-body">
            <h3><a href={entryUrl(q, 'quotes')}>{q.data.title.replace(/\s*\|\s*ThinkTank$/, '')}</a></h3>
            <span class="meta">{fmt(q.data.date)}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>
