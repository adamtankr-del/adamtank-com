---
import Base from '../../layouts/Base.astro';
import QuotesPage from '../../components/QuotesPage.astro';
import { getCollection } from 'astro:content';

const PER_PAGE = 20;
const quotes = (await getCollection('quotes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const totalPages = Math.ceil(quotes.length / PER_PAGE);
---
<Base title="Quotes | Adam Tank" description="A running collection of quotes worth keeping.">
  <QuotesPage entries={quotes.slice(0, PER_PAGE)} page={1} totalPages={totalPages} />
</Base>
