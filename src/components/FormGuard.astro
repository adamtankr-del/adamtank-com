---
// Bot-screening fields for public forms. Drop inside any <form data-async>.
// Server side lives in api/_guard.js.
//
// Turnstile stays dormant until PUBLIC_TURNSTILE_SITE_KEY and
// TURNSTILE_SECRET_KEY are set in the Vercel project.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<div class="hp" aria-hidden="true">
  <label for="company_website">Company website</label>
  <input
    id="company_website"
    name="company_website"
    type="text"
    tabindex="-1"
    autocomplete="off"
  />
</div>
<input type="hidden" name="_t" value="0" />
{siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-appearance="interaction-only"></div>}
{siteKey && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}

<style>
  /* Off-screen rather than display:none, which bots skip. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cf-turnstile { margin-bottom: 1rem; }
</style>
